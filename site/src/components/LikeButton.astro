---
// One tap, no account. Two of these appear per article and stay in sync; the shared
// script lives in LikeScript.astro.
import { site, type Lang } from '../site.config'
import { t } from '../lib/taxonomy'
const { lang } = Astro.props as { lang: Lang }
const L = t(lang)
---
{site.likes && (
  <button class="like" type="button" data-like aria-pressed="false" aria-label={L.like} title={L.like}>
    <svg viewBox="0 0 20 18" width="15" height="14" aria-hidden="true">
      <path
        d="M10 16.5 2.6 9.3A4.3 4.3 0 0 1 10 3.6a4.3 4.3 0 0 1 7.4 5.7L10 16.5Z"
        fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
      />
    </svg>
    <span class="n tnum" data-like-count>—</span>
  </button>
)}
