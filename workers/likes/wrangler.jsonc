{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-likes",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Origins allowed to call this Worker. Add localhost while developing.
    "ALLOWED_ORIGINS": "https://normaluhr.github.io,http://localhost:4321,http://localhost:4399"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-likes",
      "database_id": "75dfbecf-1cf0-4282-b11a-7c87122ef2b7"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
